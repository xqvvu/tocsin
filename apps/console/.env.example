BETTER_AUTH_URL=http://localhost:6180
# Placeholder only: production refuses to start with it. Generate a real one
# with `openssl rand -hex 32` before deploying.
BETTER_AUTH_SECRET=change-me-to-at-least-32-characters
# Optional: read the secret from a mounted file instead (Docker secret /
# Kubernetes secret volume). Used only when BETTER_AUTH_SECRET is empty; the
# file must be a single line readable by uid 1000 (the container's `node` user).
# BETTER_AUTH_SECRET_FILE=/run/secrets/better_auth_secret
# Comma or newline separated hosts accepted by Better Auth dynamic base URL.
# Example: localhost:6180,tocsin.example.com
BETTER_AUTH_ALLOWED_HOSTS=localhost:6180
# Comma or newline separated additional origins for auth CSRF/origin checks.
# Example: http://localhost:6180,https://tocsin.example.com
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:6180
SERVER_URL=http://localhost:6180
TOCSIN_DATABASE_PATH=data.sqlite
TOCSIN_LOG_LEVEL=info
# auto uses JSON in production and ANSI text in development.
TOCSIN_LOG_FORMAT=auto
TOCSIN_MAX_WEBHOOK_BYTES=1048576
TOCSIN_WORKER_BATCH_SIZE=10
TOCSIN_WORKER_INTERVAL_MS=5000
TOCSIN_WORKER_STALE_RUNNING_MS=300000
