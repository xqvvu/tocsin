{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "#destinations/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
